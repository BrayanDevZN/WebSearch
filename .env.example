# Obrigatória: a chave que todo cliente envia (Authorization: Bearer <chave> ou X-API-Key). Mínimo 16, ideal 32+.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SEARCH_KEY=

# Provedores de busca em ordem de preferência: ddgs, searxng
SEARCH_PROVIDERS=ddgs
# Obrigatória se SEARCH_PROVIDERS incluir searxng
SEARXNG_URL=

# Download de páginas
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=3
FETCH_CONCURRENCY=5
# FETCH_USER_AGENT=

# Servidor
HOST=127.0.0.1
PORT=8000
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
